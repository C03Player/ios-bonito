+/*
+ * Patch 0190, two switches to find out why whole 224x288 render bins of a frame still keep an older frame's pixels after 0188 (the snapshots show rectangles on that
+ * grid): boot-arg sweetgpuwfi=1 puts a CP_WAIT_FOR_IDLE after every IB of a batch (the GPU drains before the next command buffer starts: the original sync tail had one,
+ * 0167 dropped it), sweetgpubatch=N caps the IBs per batch (default 16; 1 = the pre-0179 one-IB-one-fence behavior).
+ */
+static int g6_wfi;
 int bonito_gpu_submit(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms);
 
 bool
@@ -1528,7 +1534,7 @@
 bonito_gpu_submit_n(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned n, uint32_t timeout_ms)
