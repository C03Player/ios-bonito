 }
 
+static uint32_t g6_batch_max = 16;
+
 /* up to 16 IBs in order; the fence of the last (0: the GPU is not usable) */
 uint32_t
 sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
