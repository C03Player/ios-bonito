-	uint32_t fence, got = 0, dw[16 * 13 + 5];
+	uint32_t fence, got = 0, dw[16 * 14 + 5];
 	unsigned cnt = 0;
 	int rc;
 
@@ -1574,6 +1580,9 @@
 			dw[cnt++] = (uint32_t)((fva + 0xf0) >> 32);
 			dw[cnt++] = (uint32_t)i + 1;
 		}
+		if (g6_wfi) {
+			dw[cnt++] = g6_pkt7(G6_CP_WAIT_FOR_IDLE, 0);
+		}
