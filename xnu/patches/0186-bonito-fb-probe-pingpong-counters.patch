+}
+
+/*
+ * Patch 0186 (boot-arg sweetfb_probe=1, observation only, changes nothing): how does the display engine's transfer to the command-mode panel look from the CPU?
+ * Every 100 vsync ticks the tick samples PP_LINE_COUNT (0x2c, "wr_ptr" line count: lines the engine has sent to the panel) and PP_INT_COUNT_VAL (0x14, low half: the
+ * panel read pointer's line, high half its frame count) 40 times, 100 us apart, and logs them (16 times in all). With autorefresh on (the default) this shows whether a
+ * transfer is visible, how long it lasts within a 16.7 ms frame and where the panel's own scan is: the data a tear-free copy has to be timed from (kick mode, 0184/0185,
+ * left the panel frozen: a lone CTL_START does not start a transfer).
+ */
+static volatile uint8_t *sweet_fb_pprobe;
+static unsigned sweet_fb_probe_prints;
+
+static void
+sweet_fb_probe_init(void)
+{
+	sweet_fb_pprobe = (volatile uint8_t *)ml_io_map(0xae71000, 0x1000);
+	IOLog("SWEET FB: probe: pp0 mapped %p, tear_en %#x autoref %#x\n", (void *)sweet_fb_pprobe, sweet_fb_pprobe ? *(volatile uint32_t *)(sweet_fb_pprobe + 0) : 0,
+	    sweet_fb_pprobe ? *(volatile uint32_t *)(sweet_fb_pprobe + 0x30) : 0);
+}
+
+static void
+sweet_fb_probe_burst(uint64_t count)
+{
+	uint32_t lc[40], ic[40];
+
+	if (sweet_fb_pprobe == NULL || (count % 100) != 0 || sweet_fb_probe_prints >= 16) {
+		return;
+	}
+	sweet_fb_probe_prints++;
+	for (int i = 0; i < 40; i++) {
+		lc[i] = *(volatile uint32_t *)(sweet_fb_pprobe + 0x2c);
+		ic[i] = *(volatile uint32_t *)(sweet_fb_pprobe + 0x14);
+		delay(100);
+	}
+	for (int h = 0; h < 40; h += 10) {
+		IOLog("SWEET FB: probe %llu line[%d..]: %x %x %x %x %x %x %x %x %x %x  int: %x %x %x %x %x %x %x %x %x %x\n", count, h, lc[h], lc[h + 1], lc[h + 2], lc[h + 3],
+		    lc[h + 4], lc[h + 5], lc[h + 6], lc[h + 7], lc[h + 8], lc[h + 9], ic[h], ic[h + 1], ic[h + 2], ic[h + 3], ic[h + 4], ic[h + 5], ic[h + 6], ic[h + 7], ic[h + 8],
+		    ic[h + 9]);
+	}
 }
 
