+int bonito_gpu_submit_n(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned n, uint32_t timeout_ms);
 int bonito_gpu_submit(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms);
 
 bool
@@ -1523,35 +1524,49 @@
 }
 
 int
-bonito_gpu_submit(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms)
+bonito_gpu_submit_n(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned n, uint32_t timeout_ms)
 {
 	uint64_t fva = G6_GVA_POOL + G6_OFF_SCRATCH + 0x10;
-	uint32_t fence, got = 0;
+	uint32_t fence, got = 0, dw[16 * 8 + 5];
+	unsigned cnt = 0;
 	int rc;
 
 	uint64_t st_enter = mach_absolute_time(), st_locked;
 
-	if (!g6_ready) {
+	if (!g6_ready || n == 0 || n > 16) {
 		return -1;
 	}
 	lck_mtx_lock(&g6_lock);
 	st_locked = mach_absolute_time();
 	fence = ++g6_fence;
 	g6_submit_count++;
-	g6_last_ib_va = ib_iova;
-	g6_last_ib_dw = dwords;
+	g6_last_ib_va = ib_iova[n - 1];
+	g6_last_ib_dw = ib_dwords[n - 1];
 	/*
 	 * The submit wrapper of Linux's a6xx_submit (patch 0167): CCU invalidates in front, and the fence written by a CACHE_FLUSH_TS event, which flushes the GPU's
 	 * caches (UCHE, CCU) to memory first. A WAIT_FOR_IDLE and a plain CP_MEM_WRITE (what this was before) signal the fence while the GPU's writes still sit in
 	 * its caches: the CPU then reads stale memory (vktest's fill and copy came back 74 % wrong).
 	 */
-	uint32_t dw[] = {
-		g6_pkt7(0x46, 1), 0x18,                         /* PC_CCU_INVALIDATE_DEPTH */
-		g6_pkt7(0x46, 1), 0x19,                         /* PC_CCU_INVALIDATE_COLOR */
-		g6_pkt7(0x3f, 3), (uint32_t)ib_iova, (uint32_t)(ib_iova >> 32), dwords,
-		g6_pkt7(0x46, 4), 0x04, (uint32_t)fva, (uint32_t)(fva >> 32), fence,       /* CACHE_FLUSH_TS */
-	};
-	rc = g6_ring(dw, sizeof(dw) / 4, NULL, timeout_ms);
+	/*
+	 * Patch 0179: up to 16 IBs of one submit go into the ring together (each behind its own CCU invalidates) and ONE fence by CACHE_FLUSH_TS ends the batch, so the
+	 * GPU runs them back to back and the host waits once (before, every IB was waited for: the GPU sat idle between them, about half of the time in an animation).
+	 */
+	for (unsigned i = 0; i < n; i++) {
+		dw[cnt++] = g6_pkt7(0x46, 1);
+		dw[cnt++] = 0x18;                               /* PC_CCU_INVALIDATE_DEPTH */
+		dw[cnt++] = g6_pkt7(0x46, 1);
+		dw[cnt++] = 0x19;                               /* PC_CCU_INVALIDATE_COLOR */
+		dw[cnt++] = g6_pkt7(0x3f, 3);
+		dw[cnt++] = (uint32_t)ib_iova[i];
+		dw[cnt++] = (uint32_t)(ib_iova[i] >> 32);
+		dw[cnt++] = ib_dwords[i];
+	}
+	dw[cnt++] = g6_pkt7(0x46, 4);
+	dw[cnt++] = 0x04;                                       /* CACHE_FLUSH_TS */
+	dw[cnt++] = (uint32_t)fva;
+	dw[cnt++] = (uint32_t)(fva >> 32);
+	dw[cnt++] = fence;
+	rc = g6_ring(dw, cnt, NULL, timeout_ms);
 	g6_pread(G6_OFF_SCRATCH + 0x10, &got, 4);
 	/*
 	 * A translation fault does not make this submit fail, but it stalls the next one until the context bank's FSR is
@@ -1566,6 +1581,12 @@
 	g6_stats_note(st_locked - st_enter, mach_absolute_time() - st_locked);
 	lck_mtx_unlock(&g6_lock);
 	return rc;
+}
+
+int
+bonito_gpu_submit(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms)
+{
+	return bonito_gpu_submit_n(&ib_iova, &dwords, 1, timeout_ms);
 }
 
