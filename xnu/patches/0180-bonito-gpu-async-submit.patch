 int
-sweet_gpu_wait_fence(uint32_t fence, __unused uint32_t timeout_ms)
-{
-	return (int32_t)(__atomic_load_n(&g6_fence, __ATOMIC_RELAXED) - fence) >= 0 ? 0 : 1;
+sweet_gpu_wait_fence(uint32_t fence, uint32_t timeout_ms)
+{
+	if (!g6_ready) {
