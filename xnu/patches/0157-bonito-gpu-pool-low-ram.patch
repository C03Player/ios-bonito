diff --git a/bsd/dev/bonito_gpu.c b/bsd/dev/bonito_gpu.c
--- a/bsd/dev/bonito_gpu.c
+++ b/bsd/dev/bonito_gpu.c
@@ -1309,7 +1309,7 @@
  * Adreno 615 version on top of the service layer above. Submits are synchronous (about 35 us for a small IB), so a fence is
  * complete by the time it is handed out.
  *
- *   boot-args: sweetgpu=6 (service), sweetmtl=1|2 (publish IOAcceleratorES; 2 = the Turnip ABI), sweetgpupool=MB (default 96)
+ *   boot-args: sweetgpu=6 (service), sweetmtl=1|2 (publish IOAcceleratorES; 2 = the Turnip ABI), sweetgpupool=MB (default 192, at most 204)
  */
 #define G6_WIN_BASE     0x1000000000ull         /* client windows: 4 GiB each from 64 GiB up, inside the 39-bit VA space */
 #define G6_WIN_SIZE     0x100000000ull
@@ -1323,32 +1323,36 @@
 static uint32_t g6_ext_n;
 static uint64_t g6_upool_pa, g6_upool_len;
 
+/*
+ * The pool must be RAM that XNU does not manage: a write-combined view of a managed page is a mismatched alias of its cacheable one (writes
+ * lost, reads stale; the Pixel 4 port learned that with Turnip's command streams). XNU on bonito manages only the RAM above 4 GiB
+ * (mkadt.py HIGH_PHYS_BASE), so the low bank is free: above the last fixed carve-out (below 0xac800000, stock DTB) and below the end of the
+ * low bank (0xbcc00000). An early boot stage already ran XNU out of 0xb0000000.., so the CPU may use it. 16 KiB units, no kernel mapping
+ * (SweetAccelerator maps and zeroes each buffer write-combined itself).
+ */
+#define G6_UPOOL_BASE   0xb0000000ull
+#define G6_UPOOL_MAX    0x0cc00000ull           /* up to 0xbcc00000 */
+
 static void
 g6_upool_alloc(uint32_t mb)
 {
-	vm_offset_t va = 0;
-	uint64_t len;
-
-	for (; mb >= 8; mb /= 2) {
-		len = (uint64_t)mb << 20;
-		if (kmem_alloc_contig(kernel_map, &va, len, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
-		    VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
-			g6_upool_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va));
-			g6_upool_len = len;
-			/* nothing touches this memory through the cacheable kernel mapping again; the GPU and the WC user maps own it */
-			flush_dcache64((addr64_t)g6_upool_pa, (unsigned)len, TRUE);
-			g6_ext[0].pa = g6_upool_pa;
-			g6_ext[0].len = len;
-			g6_ext_n = 1;
-			printf("SWEET GPU615: user pool %u MiB at pa %#llx\n", mb, (unsigned long long)g6_upool_pa);
-			return;
-		}
-	}
-	printf("SWEET GPU615: no contiguous user pool (userland buffers will be refused)\n");
-}
-
-/* the fitted display rectangle SweetFramebuffer publishes for the touch mapping (defined by the Pixel 4 GPU file otherwise) */
-int sweet_display_fit_x, sweet_display_fit_y, sweet_display_fit_w, sweet_display_fit_h;
+	uint64_t len = (uint64_t)mb << 20;
+
+	if (len > G6_UPOOL_MAX) {
+		len = G6_UPOOL_MAX;
+	}
+	len &= ~(uint64_t)PAGE_MASK;
+	if (len == 0) {
+		return;
+	}
+	g6_upool_pa = G6_UPOOL_BASE;
+	g6_upool_len = len;
+	g6_ext[0].pa = G6_UPOOL_BASE;
+	g6_ext[0].len = len;
+	g6_ext_n = 1;
+	printf("SWEET GPU615: user pool %llu MiB of unmanaged low RAM at pa %#llx\n", (unsigned long long)(len >> 20),
+	    (unsigned long long)G6_UPOOL_BASE);
+}
 
 void
 sweet_gpu_init(void)
@@ -1599,9 +1603,9 @@
 		(void)g6_pool_alloc();          /* early: contiguous memory is gone once the system has run for a while */
 	}
 	if (enabled >= 6) {
-		uint32_t mtl = 0, mb = 96;
+		uint32_t mtl = 0, mb = 192;
 		PE_parse_boot_argn("sweetmtl", &mtl, sizeof(mtl));
-		PE_parse_boot_argn("sweetgpupool", &mb, sizeof(mb));
+		PE_parse_boot_argn("sweetgpupool", &mb, sizeof(mb));      /* MB, at most 204 */
 		if (mtl) {
 			g6_upool_alloc(mb);     /* contiguous GPU memory for userland buffers: claimed now, it cannot be later */
 		}
