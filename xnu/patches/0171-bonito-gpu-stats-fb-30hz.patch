 /* An indirect buffer, WAIT_FOR_IDLE and a fence write; 0 when the fence landed within timeout_ms. A fault is cleared. */
+/*
+ * Patch 0171: timing statistics, printed at most every 5 s while the GPU is in use ("submit stats"): how long the submits run, how long they wait
+ * for g6_lock, and how much time the GPU page mapping takes (all in the same lock), to tell kernel time from userland time in a slow frame.
+ */
+
+static void
+g6_stats_note(uint64_t wait_abs, uint64_t run_abs)
+{
+	uint64_t wait_ns, run_ns, now = mach_absolute_time(), since;
+
+	absolutetime_to_nanoseconds(wait_abs, &wait_ns);
+	absolutetime_to_nanoseconds(run_abs, &run_ns);
+	g6_st_n++;
+	g6_st_run += run_ns;
+	g6_st_wait += wait_ns;
+	if (run_ns > g6_st_runmax) {
+		g6_st_runmax = run_ns;
+	}
+	if (wait_ns > g6_st_waitmax) {
+		g6_st_waitmax = wait_ns;
+	}
+	if (g6_st_t0 == 0) {
+		g6_st_t0 = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - g6_st_t0, &since);
+	if (since >= 5000000000ull) {
+		printf("SWEET GPU615: submit stats %llu ms: %llu submits, run avg %llu us max %llu us, lock wait avg %llu us max %llu us; mapping %llu calls %llu pages %llu us\n",
+		    (unsigned long long)(since / 1000000ull), (unsigned long long)g6_st_n, (unsigned long long)(g6_st_run / g6_st_n / 1000),
+		    (unsigned long long)(g6_st_runmax / 1000), (unsigned long long)(g6_st_wait / g6_st_n / 1000),
+		    (unsigned long long)(g6_st_waitmax / 1000), (unsigned long long)g6_st_mapn, (unsigned long long)g6_st_mappages,
+		    (unsigned long long)(g6_st_mapns / 1000));
+		g6_st_t0 = now;
+		g6_st_n = g6_st_run = g6_st_runmax = g6_st_wait = g6_st_waitmax = g6_st_mapn = g6_st_mappages = g6_st_mapns = 0;
+	}
+}
+
 int
 bonito_gpu_submit(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms)
 {
@@ -1401,10 +1450,13 @@
 	uint32_t fence, got = 0;
 	int rc;
 
+	uint64_t st_enter = mach_absolute_time(), st_locked;
+
 	if (!g6_ready) {
 		return -1;
 	}
 	lck_mtx_lock(&g6_lock);
+	st_locked = mach_absolute_time();
 	fence = ++g6_fence;
 	g6_submit_count++;
 	g6_last_ib_va = ib_iova;
@@ -1432,6 +1484,7 @@
 		rc = -1;
 		g6_hang_dump();
 	}
+	g6_stats_note(st_locked - st_enter, mach_absolute_time() - st_locked);
 	lck_mtx_unlock(&g6_lock);
 	return rc;
 }
