-static uint32_t g6_batch_max = 16;
+/*
+ * Patch 0191: one IB per batch (and fence) is the default. Series of gesture boots with 16 snapshots each (logs/seam-sweep.txt): with up to 16 IBs behind one fence 7 to 9 % of the snapshots
+ * held a rectangle of an older frame (whole 224x288 render bins), with one IB per fence none in 160, with or without a CP_WAIT_FOR_IDLE between the IBs (0190's sweetgpuwfi: no change). One IB per
+ * fence costs speed (6.5 swaps/s against 9.6), mostly through the in-flight limit, which counts fences: sweetgpuinflight=N (default 3) raises it.
+ */
+static uint32_t g6_batch_max = 1;
 
