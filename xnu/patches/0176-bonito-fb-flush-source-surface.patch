 /*
+ * Patch 0176: the CPU present reads the frame backboardd's GPU rendered. The GPU writes DRAM and does not go through this CPU's caches, and backboardd
+ * recycles a few surfaces: lines of an earlier read of the same surface stay in the CPU cache, so a copy mixed old and new lines (64 bytes each) wherever two
+ * frames differ (the status bar while it fades) and, as nothing redraws afterwards, the torn frame stayed on the panel (dashed, sheared streaks where the clock
+ * and battery belong). Clean and invalidate the source range before reading it (dirty lines go to memory first, nothing is lost).
+ */
+static inline void
+sweet_fb_flush_src(uintptr_t va, size_t len)
+{
+	uintptr_t a = va & ~(uintptr_t)63, end = va + len;
+
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r" (a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
  * One row of the CPU copy, n pixels to panel (x, y): rows in the corner bands
  * are darkened on the way (the GPU path has its own mattes), so the panel
  * never shows the corners unmasked.
