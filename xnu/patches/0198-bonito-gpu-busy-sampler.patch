diff --git a/bsd/dev/bonito_gpu.c b/bsd/dev/bonito_gpu.c
--- a/bsd/dev/bonito_gpu.c
+++ b/bsd/dev/bonito_gpu.c
@@ -2447,6 +2447,38 @@
 	sweet_hid_touch(8, 0, x2, y2);
 }
 
+/*
+ * Patch 0198 (boot-arg sweetgpustat=1): how busy is the GPU? Every 100 us the sampler asks whether the command processor has work (read pointer behind the write pointer) or the GPU's
+ * status register says busy (bit 23, the test the idle waits use), and whether a fence is outstanding; every 5 s it logs the shares. Tells a GPU-bound frame rate (busy near 100 %) from one
+ * limited by the latency through the stages (translation, submit, GPU, completion) with the GPU idle part of the time.
+ */
+static void
+g6_stat_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	while (!g6_ready) {
+		delay(500000);
+	}
+	for (;;) {
+		uint64_t t0 = mach_absolute_time(), ns = 0;
+		unsigned total = 0, busy = 0, cp = 0, queued = 0;
+
+		while (ns < 5000000000ull) {
+			uint32_t st = g6_rd(G6_GMU(G6_RBBM_STATUS));
+			bool work = g6_rd(G6_GMU(G6_CP_RB_RPTR)) != g6_wptr;
+			total++;
+			cp += work ? 1 : 0;
+			busy += (work || (st & (1u << 23))) ? 1 : 0;
+			if ((total & 7) == 0 && (int32_t)(__atomic_load_n(&g6_fence, __ATOMIC_RELAXED) - g6_fence_done()) > 0) {
+				queued++;
+			}
+			delay(100);
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		}
+		printf("SWEET GPU615: stat %llu ms: gpu busy %u%%, ring has work %u%%, a fence outstanding %u%% (%u samples)\n", (unsigned long long)(ns / 1000000ull),
+		    total ? 100 * busy / total : 0, total ? 100 * cp / total : 0, total >= 8 ? 800 * queued / total : 0, total);
+	}
+}
+
 static void
 g6_swipe_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -2527,6 +2559,11 @@
 	    kernel_thread_start(g6_swipe_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	uint32_t gstat = 0;
+	if (PE_parse_boot_argn("sweetgpustat", &gstat, sizeof(gstat)) && gstat &&
+	    kernel_thread_start(g6_stat_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
