diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -163,6 +163,35 @@
 	    al.file, al.fork, (unsigned long long)arg[4], e);
 }
 
+/*
+ * Syscall trace window: after a sweetfail process opens an Assets.car (sweet_trace_open arms it), print the next 150
+ * BSD system calls of that process as "SWEET SYS name[pid] number -> err N rv 0x.. args ..." to see what the asset code
+ * does with the file (fstat, mmap, read, close, ...). Mach traps are not covered.
+ */
+static int _Atomic sweet_trace_pid;
+static int _Atomic sweet_trace_left;
+
+void sweet_sys_trace_arm(int pid);
+void
+sweet_sys_trace_arm(int pid)
+{
+	os_atomic_store(&sweet_trace_pid, pid, relaxed);
+	os_atomic_store(&sweet_trace_left, 150, relaxed);
+}
+
+static void
+sweet_sys_trace(proc_t p, unsigned code, int error, const uint64_t *arg, int64_t rv)
+{
+	if (os_atomic_load(&sweet_trace_left, relaxed) <= 0 || proc_getpid(p) != os_atomic_load(&sweet_trace_pid, relaxed)) {
+		return;
+	}
+	if (os_atomic_dec_orig(&sweet_trace_left, relaxed) <= 0) {
+		return;
+	}
+	printf("SWEET SYS %s[%d] %u -> err %d rv 0x%llx args 0x%llx 0x%llx 0x%llx 0x%llx\n", p->p_comm, proc_getpid(p), code,
+	    error, (unsigned long long)rv, arg[0], arg[1], arg[2], arg[3]);
+}
+
 void sweet_sys_dump(const char *name, int pid);
 void
 sweet_sys_dump(const char *name, int pid)
@@ -299,6 +328,7 @@
 		sweet_sys_note(proc, code, error);
 		sweet_sys_attr(proc, code, error, &uthread->uu_arg[0]);
 	}
+	sweet_sys_trace(proc, code, error, &uthread->uu_arg[0], (int64_t)uthread->uu_rval[0]);
 #endif
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
