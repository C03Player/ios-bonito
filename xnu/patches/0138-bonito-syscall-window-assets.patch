 				printf("SWEET OPEN %s[%d] %s flags 0x%x -> %d\n", p->p_comm, proc_getpid(p), path, oflags, error);
+				if (error == 0 && strnstr(path, "Assets.car", strlen(path) + 1) != NULL) {
