diff --git a/bsd/dev/bonito_gpu.c b/bsd/dev/bonito_gpu.c
--- a/bsd/dev/bonito_gpu.c
+++ b/bsd/dev/bonito_gpu.c
@@ -1493,6 +1493,129 @@
 	    (unsigned long long)g6_fault_count);
 }
 
+/*
+ * 2D blit self test (patch 0166, sweetgputest=30: buffers in the kernel's 4 MiB pool = managed high RAM; 31: buffers in the user pool = unmanaged low RAM):
+ * the IB is the Pixel 4 driver's working Turnip r2d blit (ios-flame sweet_a6xx.c a6_blit_ib) copying 64x1 pixels. Prints PASS, a data mismatch, or
+ * the submit failure (a hang), so a hang in the 2D engine is separated from a hang caused by the memory the buffers are in.
+ */
+extern int sweet_gpu_pool_alloc(uint64_t, uint64_t *);
+extern uint64_t bonito_gpu_va_alloc(uint64_t);
+extern int bonito_gpu_map_pages(uint64_t, const uint64_t *, uint32_t, uint32_t);
+
+static void
+g6_blit_test(unsigned sel)
+{
+	static const uint32_t init[][2] = {
+		{ 0x9804, 0x1f }, { 0x9805, 1 }, { 0xa0f8, 1 }, { 0xb600, 0x8000 }, { 0x8600, 0 },
+		{ 0xae03, 0x420 }, { 0xae00, 0 }, { 0xbe04, 0 }, { 0x9600, 0x2000000 }, { 0x0e12, 1 },
+		{ 0x8e01, 1 }, { 0x8e04, 0x4100000 }, { 0xae04, 0 }, { 0xae0f, 0x3f }, { 0xb605, 0x44 },
+		{ 0xbe00, 0x80 }, { 0xbe01, 0 }, { 0xab20, 0 }, { 0xb182, 0 }, { 0xbb11, 0 }, { 0xa9a8, 0 },
+		{ 0xab00, 5 }, { 0xa009, 3 }, { 0x8811, 0x10 }, { 0x8110, 0 }, { 0x8818, 0 }, { 0x8819, 0 },
+		{ 0x881a, 0 }, { 0x881b, 0 }, { 0x881c, 0 }, { 0x881d, 0 }, { 0x881e, 0 }, { 0x88f0, 0 },
+		{ 0x9236, 0 }, { 0x9300, 0 }, { 0x9306, 1 }, { 0xb183, 0 }, { 0x80af, 0 }, { 0x8099, 0 },
+		{ 0x980a, 0 }, { 0x9210, 0 }, { 0x9211, 0 }, { 0x9602, 0 }, { 0x9e72, 0 }, { 0xb309, 0xa2 },
+		{ 0xb986, 0xfc }, { 0xa007, 0 }, { 0x8864, 0 }, { 0xb800, 0x102 }, { 0x8e07, 0x10000000 },
+	};
+	uint8_t pattern[256], got[256];
+	uint32_t dw[256], n = 0, i;
+	uint64_t src_va, dst_va, border = G6_GVA_POOL + G6_OFF_SCRATCH + 0x800, ts = G6_GVA_POOL + G6_OFF_SCRATCH + 0x900;
+	vm_offset_t src_k = 0, dst_k = 0;
+	int rc;
+
+	for (i = 0; i < sizeof(pattern); i++) {
+		pattern[i] = (uint8_t)(i * 7 + 3);
+	}
+	if (sel == 30) {
+		static const uint8_t zeros[256];
+		src_va = G6_GVA_POOL + 0x320000;
+		dst_va = G6_GVA_POOL + 0x340000;
+		g6_pwrite(0x320000, pattern, sizeof(pattern));
+		g6_pwrite(0x340000, zeros, sizeof(zeros));
+	} else {
+		uint64_t spa = 0, dpa = 0;
+
+		if (sweet_gpu_pool_alloc(0x4000, &spa) || sweet_gpu_pool_alloc(0x4000, &dpa)) {
+			printf("SWEET GPU615: BLIT TEST %u: no pool memory\n", sel);
+			return;
+		}
+		src_k = ml_io_map_wcomb((vm_offset_t)spa, 0x4000);
+		dst_k = ml_io_map_wcomb((vm_offset_t)dpa, 0x4000);
+		if (!src_k || !dst_k) {
+			printf("SWEET GPU615: BLIT TEST %u: cannot map the pool pages for the CPU\n", sel);
+			return;
+		}
+		src_va = bonito_gpu_va_alloc(0x4000);
+		dst_va = bonito_gpu_va_alloc(0x4000);
+		if (bonito_gpu_map_pages(src_va, &spa, 1, 0x4000) || bonito_gpu_map_pages(dst_va, &dpa, 1, 0x4000)) {
+			printf("SWEET GPU615: BLIT TEST %u: cannot map the pool pages for the GPU\n", sel);
+			return;
+		}
+		memcpy((void *)src_k, pattern, sizeof(pattern));
+		memset((void *)dst_k, 0, sizeof(pattern));
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+#define EV(e) do { dw[n++] = g6_pkt7(0x46, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e) do { dw[n++] = g6_pkt7(0x46, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v) do { dw[n++] = 0x40000000u | 1u | (g6_parity(1) << 7) | ((uint32_t)(r) << 8) | (g6_parity(r) << 27); dw[n++] = (v); } while (0)
+#define REGN(r, c) do { dw[n++] = 0x40000000u | (c) | (g6_parity(c) << 7) | ((uint32_t)(r) << 8) | (g6_parity(r) << 27); } while (0)
+	EV(0x31);
+	REG(0xbb08, 0xfffff);
+	dw[n++] = g6_pkt7(G6_CP_WAIT_FOR_IDLE, 0);
+	for (i = 0; i < sizeof(init) / sizeof(init[0]); i++) {
+		REG(init[i][0], init[i][1]);
+	}
+	REGN(0xb302, 2); dw[n++] = (uint32_t)border; dw[n++] = (uint32_t)(border >> 32);
+	REGN(0xb180, 2); dw[n++] = (uint32_t)border; dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(0x1d);
+	EV(0x19);
+	EV(0x31);
+	dw[n++] = g6_pkt7(G6_CP_WAIT_FOR_IDLE, 0);
+	REG(0x8c01, 0);
+	REG(0x8c00, 0x00f03000);
+	REG(0x8400, 0x00f03000);
+	REG(0xacc0, 0xf180);
+	REGN(0x8405, 2); dw[n++] = 0; dw[n++] = 63;
+	REGN(0x8401, 4); dw[n++] = 0; dw[n++] = 63u << 8; dw[n++] = 0; dw[n++] = 0;
+	REGN(0xb4c0, 5);
+	dw[n++] = 0x00500430;
+	dw[n++] = 64u | (1u << 15);
+	dw[n++] = (uint32_t)src_va;
+	dw[n++] = (uint32_t)(src_va >> 32);
+	dw[n++] = 256u << 3;
+	REGN(0xb4ca, 3); dw[n++] = (uint32_t)src_va; dw[n++] = (uint32_t)(src_va >> 32); dw[n++] = 0;
+	REGN(0x8c17, 4);
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)dst_va;
+	dw[n++] = (uint32_t)(dst_va >> 32);
+	dw[n++] = 256u >> 6;
+	REGN(0x8c20, 3); dw[n++] = (uint32_t)dst_va; dw[n++] = (uint32_t)(dst_va >> 32); dw[n++] = 0;
+	dw[n++] = g6_pkt7(0x2c, 1);
+	dw[n++] = 3;
+	EV_TS(0x1d);
+	EV_TS(0x1c);
+	EV_TS(0x04);
+#undef EV
+#undef EV_TS
+#undef REG
+#undef REGN
+	g6_pwrite(G6_OFF_TEST_IB, dw, 4u * n);
+	rc = bonito_gpu_submit(G6_GVA_POOL + G6_OFF_TEST_IB, n, 500);
+	if (rc) {
+		printf("SWEET GPU615: BLIT TEST %u (%u dwords): submit rc %d (the 2D blit %s)\n", sel, n, rc, rc == -2 ? "faulted" : "hung the GPU");
+		return;
+	}
+	if (sel == 30) {
+		g6_pread(0x340000, got, sizeof(got));
+	} else {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		memcpy(got, (void *)dst_k, sizeof(got));
+	}
+	for (i = 0; i < 64 * 4 && got[i] == pattern[i]; i++) {
+	}
+	printf("SWEET GPU615: BLIT TEST %u (%u dwords): submit rc 0, %s (first mismatch at byte %u of 256; dst[0..3] %02x %02x %02x %02x)\n", sel, n,
+	    i == 256 ? "PASS: the 2D blit copied the data" : "FAIL: the destination differs", i, got[0], got[1], got[2], got[3]);
+}
+
 static void
 g6_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1578,6 +1701,10 @@
 		(void)tsleep(&g6_chan, PZERO, "g6idle", hz * 15);
 		uint32_t tib[160], tn = 0;
 
+		if (n == 1 && (g6_testsel == 30 || g6_testsel == 31)) {
+			g6_blit_test(g6_testsel);
+			continue;
+		}
 		if (n == 1 && g6_testsel) {
 			tn = g6_test_ib(g6_testsel, tib, G6_GVA_POOL + G6_OFF_SCRATCH + 0x40);
 		}
