+/*
+ * Patch 0187: time the CPU copy to the panel's frame (boot-arg sweetfb_sync=PERMILLE, default 0 = off). The probe of 0186 shows PP_INT_COUNT_VAL's low half (the panel read
+ * pointer's line) counting 0x872 .. 0x10e4 (2162 lines, one 16.7 ms frame) over and over; the display engine starts its transfer of the framebuffer to the panel right after
+ * the wrap (tear check start position = the visible height), and that read of the framebuffer is what a copy in flight tears. The copy (5.6 ms) therefore starts only while the
+ * frame is between PERMILLE and PERMILLE+150 thousandths old (7.5 ms .. 10 ms at 450): the transfer is over (an assumption: a DSC compressed frame over 4 lanes takes about
+ * 5 ms) and the copy ends before the next one begins. The tick waits for that window (at most one frame, in 50 us steps).
+ */
+static uint32_t sweet_fb_sync_start;
+
+static inline uint32_t
+sweet_fb_frame_permille(void)
+{
+	uint32_t v = *(volatile uint32_t *)(sweet_fb_pprobe + 0x14) & 0xffff;
+
+	return v < 0x872 ? 0 : (v - 0x872) * 1000 / 0x872;
+}
+
+static void
+sweet_fb_wait_frame_window(void)
+{
+	if (sweet_fb_pprobe == NULL || sweet_fb_sync_start == 0) {
+		return;
+	}
+	for (int n = 0; n < 400; n++) {
+		uint32_t p = sweet_fb_frame_permille();
+
+		if (p >= sweet_fb_sync_start && p < sweet_fb_sync_start + 150) {
+			return;
+		}
+		delay(50);
+	}
+}
+
