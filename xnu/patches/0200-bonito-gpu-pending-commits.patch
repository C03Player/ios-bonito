diff --git a/bsd/dev/bonito_gpu.c b/bsd/dev/bonito_gpu.c
--- a/bsd/dev/bonito_gpu.c
+++ b/bsd/dev/bonito_gpu.c
@@ -2626,3 +2626,33 @@
 	return 0;
 }
 SYSCTL_PROC(_kern, OID_AUTO, sweet_bind_cpu, CTLTYPE_INT | CTLFLAG_WR | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0, sweet_bind_cpu_sysctl, "I", "bind the calling thread to a cpu, -1 unbinds");
+
+/*
+ * Patch 0200: kern.sweet_gpu_pending, write-only: the Metal plugin adds +1 when the render server commits a command buffer and -1 when the runtime's commit of it has returned (the work is then
+ * in the ring). The render server used to be held in waitUntilScheduled until its whole frame was translated and submitted (the profiler of the render thread: 71 % of its time there); with
+ * that wait skipped it swaps earlier, so the panel copy must not note "the newest fence" for a swap while a commit is still pending: sweet_gpu_pending() says so.
+ */
+static int g6_pending;
+
+int
+sweet_gpu_pending(void)
+{
+	return __atomic_load_n(&g6_pending, __ATOMIC_RELAXED);
+}
+
+static int
+sweet_gpu_pending_sysctl SYSCTL_HANDLER_ARGS
+{
+	int delta = 0, error;
+
+	error = sysctl_handle_int(oidp, &delta, 0, req);
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	int now = __atomic_add_fetch(&g6_pending, delta, __ATOMIC_RELAXED);
+	if (now < 0) {
+		__atomic_store_n(&g6_pending, 0, __ATOMIC_RELAXED);
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_pending, CTLTYPE_INT | CTLFLAG_WR | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0, sweet_gpu_pending_sysctl, "I", "commits of the render server not yet submitted (+1 / -1)");
