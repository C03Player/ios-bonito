+/* Bilinear blend of two BGRA pixels, w = 0..255 the weight of b; two channels per multiply. */
+static inline uint32_t
+sweet_lerp32(uint32_t a, uint32_t b, uint32_t w)
+{
+	uint32_t iw = 256 - w;
+	uint32_t rb = (((a & 0x00ff00ffu) * iw + (b & 0x00ff00ffu) * w) >> 8) & 0x00ff00ffu;
+	uint32_t ag = (((a >> 8) & 0x00ff00ffu) * iw + ((b >> 8) & 0x00ff00ffu) * w) & 0xff00ff00u;
+	return rb | ag;
+}
