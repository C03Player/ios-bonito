diff --git a/bsd/dev/bonito_gpu.c b/bsd/dev/bonito_gpu.c
--- a/bsd/dev/bonito_gpu.c
+++ b/bsd/dev/bonito_gpu.c
@@ -2187,18 +2187,25 @@
 }
 
 /*
- * Patch 0182: the CPU copy of a frame to the panel (SweetFramebuffer.cpp, in the vsync tick) must not read a surface the GPU is still drawing. Until the asynchronous
- * submits (0180) a submit returned only when the GPU was done, so a frame was complete whenever the swap arrived; now CoreAnimation swaps at "scheduled" and the copy
- * caught half-rendered frames (tile-shaped blocks of the old frame, a doubled search field). Wait, at most 100 ms, for the GPU to finish what has been submitted
- * so far (a newer frame's work is not waited for: the fence is read once).
+ * Patches 0182 and 0183: the CPU copy of a frame to the panel (SweetFramebuffer.cpp, in the vsync tick) must not read a surface the GPU is still drawing. Until the
+ * asynchronous submits (0180) a submit returned only when the GPU was done, so a frame was complete whenever the swap arrived; now CoreAnimation swaps at
+ * "scheduled" and the copy caught half-rendered frames (tile-shaped blocks of the old frame, a doubled search field). The swap records the newest fence
+ * (sweet_gpu_latest_fence) and the vsync tick copies only when the GPU has written it (sweet_gpu_fence_done), else it tries again on the next tick: no thread waits,
+ * and a copy always starts on a vsync (0182 waited inside the copy: 55-78 ms per copy, started at any point of the scan-out and tore the panel along one line).
  */
-void
-sweet_gpu_wait_submitted(void)
+uint32_t
+sweet_gpu_latest_fence(void)
+{
+	return __atomic_load_n(&g6_fence, __ATOMIC_RELAXED);
+}
+
+int
+sweet_gpu_fence_done(uint32_t fence)
 {
 	if (!g6_ready || !g6_async) {
-		return;
-	}
-	(void)g6_wait_fence_ms(__atomic_load_n(&g6_fence, __ATOMIC_RELAXED), 100);
+		return 1;
+	}
+	return (int32_t)(g6_fence_done() - fence) >= 0;
 }
 
