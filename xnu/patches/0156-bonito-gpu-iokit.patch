+}
+
+/* up to 16 IBs in order; the fence of the last (0: the GPU is not usable) */
+uint32_t
+sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
+{
+	if (busy) {
+		*busy = false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		int rc = bonito_gpu_submit(iova[i], dwords[i], 2000);
+		if (rc != 0 && rc != -2) {
+			return 0;
+		}
+	}
+	return __atomic_load_n(&g6_fence, __ATOMIC_RELAXED);
+}
+
+bool
+sweet_gpu_lost(uint64_t *epoch, __unused uint32_t last_fence)
+{
+	if (epoch) {
+		*epoch = 0;
+	}
+	return false;
+}
