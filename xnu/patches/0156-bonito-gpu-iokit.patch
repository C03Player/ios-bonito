+
+int
+sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
+{
+	int rc = -1;
+	bytes = (bytes + PAGE_MASK) & ~(uint64_t)PAGE_MASK;
+	lck_mtx_lock(&g6_lock);
+	for (uint32_t i = 0; i < g6_ext_n; i++) {
+		if (g6_ext[i].len >= bytes) {
+			*pa = g6_ext[i].pa;
+			g6_ext[i].pa += bytes;
+			g6_ext[i].len -= bytes;
+			if (g6_ext[i].len == 0) {
+				memmove(&g6_ext[i], &g6_ext[i + 1], (g6_ext_n - i - 1) * sizeof(g6_ext[0]));
+				g6_ext_n--;
+			}
+			rc = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&g6_lock);
+	return rc;
+}
+
+uint64_t
+sweet_gpu_pool_avail(void)
+{
+	uint64_t sum = 0;
+	lck_mtx_lock(&g6_lock);
+	for (uint32_t i = 0; i < g6_ext_n; i++) {
+		sum += g6_ext[i].len;
+	}
+	lck_mtx_unlock(&g6_lock);
+	return sum;
+}
+
+void
+sweet_gpu_pool_free(uint64_t pa, uint64_t bytes)
+{
+	uint32_t i;
+	bytes = (bytes + PAGE_MASK) & ~(uint64_t)PAGE_MASK;
+	lck_mtx_lock(&g6_lock);
+	for (i = 0; i < g6_ext_n && g6_ext[i].pa < pa; i++) {
+	}
+	if (i > 0 && g6_ext[i - 1].pa + g6_ext[i - 1].len == pa) {
+		g6_ext[i - 1].len += bytes;                 /* merge with the previous extent */
+		if (i < g6_ext_n && g6_ext[i - 1].pa + g6_ext[i - 1].len == g6_ext[i].pa) {
+			g6_ext[i - 1].len += g6_ext[i].len;
+			memmove(&g6_ext[i], &g6_ext[i + 1], (g6_ext_n - i - 1) * sizeof(g6_ext[0]));
+			g6_ext_n--;
+		}
+	} else if (i < g6_ext_n && pa + bytes == g6_ext[i].pa) {
+		g6_ext[i].pa = pa;                          /* merge with the next */
+		g6_ext[i].len += bytes;
+	} else if (g6_ext_n < G6_EXTENTS) {
+		memmove(&g6_ext[i + 1], &g6_ext[i], (g6_ext_n - i) * sizeof(g6_ext[0]));
+		g6_ext[i].pa = pa;
+		g6_ext[i].len = bytes;
+		g6_ext_n++;
+	}                                                   /* else: leaked (the table is full) */
+	lck_mtx_unlock(&g6_lock);
+}
