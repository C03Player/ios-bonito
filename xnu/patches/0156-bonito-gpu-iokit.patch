+}
+
+int
+sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out)
+{
+	int rc = bonito_gpu_submit(ib_iova, dwords, timeout_ms);
+	if (fence_out) {
+		*fence_out = __atomic_load_n(&g6_fence, __ATOMIC_RELAXED);
+	}
+	return rc;
+}
+
+/* 0: the GPU is not usable (a fault was cleared and the fence is complete, so that is not "not usable") */
+uint32_t
+sweet_gpu_submit_user_async(uint64_t ib_iova, uint32_t dwords)
+{
+	int rc = bonito_gpu_submit(ib_iova, dwords, 2000);
+	return (rc == 0 || rc == -2) ? __atomic_load_n(&g6_fence, __ATOMIC_RELAXED) : 0;
+}
+
+int
+sweet_gpu_wait_fence(uint32_t fence, __unused uint32_t timeout_ms)
+{
+	return (int32_t)(__atomic_load_n(&g6_fence, __ATOMIC_RELAXED) - fence) >= 0 ? 0 : 1;
+}
+
+int
+sweet_gpu_wait_fence_ns(uint32_t fence, __unused uint64_t timeout_ns)
+{
+	return sweet_gpu_wait_fence(fence, 0);
+}
+
+int
+sweet_gpu_window_alloc(uint64_t *base, uint64_t *size)
+{
+	int rc = -1;
+	lck_mtx_lock(&g6_lock);
+	for (unsigned i = 0; i < G6_WINDOWS; i++) {
+		if (!(g6_win_used & (1u << i))) {
+			g6_win_used |= 1u << i;
+			*base = G6_WIN_BASE + G6_WIN_SIZE * i;
+			*size = G6_WIN_SIZE;
+			rc = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&g6_lock);
+	return rc;
+}
+
+void
+sweet_gpu_window_free(uint64_t base)
+{
+	if (base >= G6_WIN_BASE && base < G6_WIN_BASE + G6_WIN_SIZE * G6_WINDOWS) {
+		lck_mtx_lock(&g6_lock);
+		g6_win_used &= ~(1u << ((base - G6_WIN_BASE) / G6_WIN_SIZE));
+		lck_mtx_unlock(&g6_lock);
+	}
+}
+
+int
+sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages)
