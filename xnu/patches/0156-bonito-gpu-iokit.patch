+int
+sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	uint64_t va = bonito_gpu_va_alloc((uint64_t)npages * page_size);
+	int rc = bonito_gpu_map_pages(va, pages, npages, page_size);
+	if (!rc) {
+		*iova_out = va;
+	}
+	return rc;
+}
