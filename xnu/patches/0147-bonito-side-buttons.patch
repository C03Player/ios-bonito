+/*
+ * Bonito side buttons (boot-arg sweetbkeys=0 disables), polled over SPMI like the Pixel 4 / Redmi port does (same
+ * PMIC arbiter v5 at 0xc440000, observer channel reads only, nothing is ever written):
+ *   power        PM660 (SID 0) PON peripheral 0x800, RT_STS (0x810) bit 0  KPDPWR_N  -> iOS key 0 (side button)
+ *   volume down  the same register, bit 1                    RESIN_N   -> iOS key 2
+ *   volume up    PM660L (SID 2) GPIO 7 (key_vol_up, pull-up input; peripheral 0xc600), INT_RT_STS (0xc610) bit 0,
+ *                low = pressed                                                -> iOS key 1
+ * (qcom,power-on@800 / key_vol_up in the stock bonito DTB.) Every change is logged ("SWEET BKEYS") so the first run
+ * shows from the log which physical button gives which bit.
+ */
+#define BK_CORE_PA      0x0c440000u
+#define BK_OBS_PA       0x0e600000u
+#define BK_CNFG_PA      0x0c40a000u
+#define BK_PON_PPID     0x008u
+#define BK_PON_RT       0x0810u
+#define BK_VOLUP_PPID   0x2c6u
+#define BK_VOLUP_RT     0xc610u
+#define BK_NO_APID      0xffffu
+
+static vm_offset_t bk_core, bk_cnfg, bk_obs;
+static int bk_chan;
+
+static uint32_t
+bk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* The arbiter can map one PPID more than once: prefer the entry the apps EE owns. */
+static uint32_t
+bk_find_apid(uint32_t ppid, uint32_t count)
+{
+	uint32_t found = BK_NO_APID;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t map = bk_rd(bk_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (found == BK_NO_APID || (bk_rd(bk_cnfg, 0x700u + 4u * i) & 7u) == 0) {
+			found = i;
+		}
+	}
+	return found;
+}
+
+static bool
+bk_read(uint32_t apid, uint32_t addr, uint8_t *out)
+{
+	if (apid == BK_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(bk_obs + off) = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = bk_rd(bk_obs, off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)bk_rd(bk_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+struct bk_ctx {
+	uint32_t pon_apid, gpio_apid;
+};
+
+static void
+bk_thread(void *arg, __unused wait_result_t wr)
+{
+	struct bk_ctx *c = (struct bk_ctx *)arg;
+	int state[3] = { 0, 0, 0 };     /* iOS key 0 power, 1 volume up, 2 volume down */
+	unsigned errors = 0;
+
+	for (;;) {
+		uint8_t pon = 0, gpio = 1;
+		bool pok = bk_read(c->pon_apid, BK_PON_RT, &pon);
+		bool gok = bk_read(c->gpio_apid, BK_VOLUP_RT, &gpio);
+		int now[3] = { !!(pon & 1u), !(gpio & 1u), !!(pon & 2u) };
+		if (!pok || !gok) {
+			if ((errors++ % 500u) == 0) {
+				printf("SWEET BKEYS: read error pon-ok=%d gpio-ok=%d\n", pok, gok);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; k++) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET BKEYS: key=%d down=%d pon=%#x volup-gpio=%#x\n", k, state[k], pon, gpio);
+				extern void sweet_hid_key(int key, int down);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		(void)tsleep(&bk_chan, PZERO, "sweetbkeys", hz / 50);
+	}
+}
+
+void sweet_bkeys_start(void);
+void
+sweet_bkeys_start(void)
+{
+	static struct bk_ctx ctx;
+	int enabled = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetbkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	bk_core = ml_io_map(BK_CORE_PA, 0x2000);
+	bk_cnfg = ml_io_map(BK_CNFG_PA, 0x1000);
+	bk_obs = ml_io_map(BK_OBS_PA, 0x10000);
+	if (!bk_core || !bk_cnfg || !bk_obs) {
+		printf("SWEET BKEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t ver = bk_rd(bk_core, 0), count = bk_rd(bk_core, 4) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || count == 0 || count > 512) {
+		printf("SWEET BKEYS: unsupported arbiter version %#x apids %u\n", ver, count);
+		return;
+	}
+	ctx.pon_apid = bk_find_apid(BK_PON_PPID, count);
+	ctx.gpio_apid = bk_find_apid(BK_VOLUP_PPID, count);
+	uint8_t pon = 0, gpio = 1;
+	bool pok = bk_read(ctx.pon_apid, BK_PON_RT, &pon), gok = bk_read(ctx.gpio_apid, BK_VOLUP_RT, &gpio);
+	printf("SWEET BKEYS: arbiter %#x, %u apids; PON apid %u (%s, RT_STS %#x), volume-up gpio apid %u (%s, RT %#x)\n",
+	    ver, count, ctx.pon_apid, pok ? "ok" : "unreadable", pon, ctx.gpio_apid, gok ? "ok" : "unreadable", gpio);
+	if (kernel_thread_start(bk_thread, &ctx, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
 int sweet_ufs_rootdev(dev_t *dev);
 
