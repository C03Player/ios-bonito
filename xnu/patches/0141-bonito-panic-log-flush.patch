+/*
+ * Panic-time log flush (hooks in osfmk/kern/debug.c): write the last 256 KiB of the console ring and its header to the
+ * eMMC from the panic path. The flush thread cannot run any more (a panic stops the other CPUs) but the driver is
+ * polled, so this works there. A panic often hits during file system I/O, i.e. another CPU was in the middle of an
+ * eMMC command and holds the lock: the system is dead anyway, so reset the command/data lines, stop any transfer,
+ * wait for the card and use the controller. The header's flush sequence is 0x50414e49 ("PANI") so a reader can tell.
+ */
+void sweet_log_panic_flush(void);
+void
+sweet_log_panic_flush(void)
+{
+	if (!su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		uint32_t r[4] = { 0 };
+		uint64_t deadline;
+		emmc_reset_lines();
+		(void)emmc_cmd(12, 0, CF(R_48B, 1, 1, 0), r);
+		nanoseconds_to_absolutetime(300ull * NSEC_PER_MSEC, &deadline);
+		deadline += mach_absolute_time();
+		for (;;) {
+			if (!emmc_cmd(13, su.rca << 16, CF(R_48, 1, 1, 0), r) && (r[0] & 0x100) && ((r[0] >> 9) & 0xf) == 4) {
+				break;
+			}
+			if (mach_absolute_time() > deadline) {
+				break;
+			}
+		}
+	}
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = total - MIN(total, (uint64_t)(256u << 10));
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = 0x50414e49,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		(void)ufs_write_blocks(base, 1);
+	}
+}
+
+/* First thing in the panic path: the panic string itself into the ring, then flush. */
+void sweet_log_panic_string(const char *fmt, va_list *args);
+void
+sweet_log_panic_string(const char *fmt, va_list *args)
+{
+	static char buf[400];
+	va_list copy;
+
+	va_copy(copy, *args);
+	int n = vsnprintf(buf, sizeof(buf), fmt, copy);
+	va_end(copy);
+	if (n < 0) {
+		n = 0;
+	}
+	if (n >= (int)sizeof(buf)) {
+		n = (int)sizeof(buf) - 1;
+	}
+	sweet_log_append("\nSWEET PANIC: ", 14);
+	sweet_log_append(buf, n);
+	sweet_log_append("\n", 1);
+	sweet_log_panic_flush();
+}
