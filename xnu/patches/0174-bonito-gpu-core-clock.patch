 /*
+ * Patch 0174: the GPU core clock. The GFX3D clock generator (GPU CC 0x101c cmd, 0x1020 cfg) was left on source 0, the 19.2 MHz crystal (the
+ * clock probe of patch 0173 measured ~10 MHz): every real draw took ~25 ms. The vendor driver never touches it either: the GMU firmware sets it
+ * from the DCVS table sent over HFI, which this driver does not use. Here the RCG is switched to GPLL0 (600 MHz, GCC; source 5 of the
+ * RCG's parent map) with the half-integer divider field 2*div-1. Boot-arg sweetgpuclk=MHz: 200, 300 (default), 400 or 600; 0 leaves the crystal.
+ * The vote level (sweetgpulvl, default 192 = SVS_L1) must cover the frequency: 180 MHz needs 64, 267 needs 128, 355 needs 192, 430 needs 256.
+ */
+#define G6_GCC_GPLL0_VOTE       0x52000u
+#define G6_GCC_GPU_GPLL0_GATE   0x52004u
+#define G6_CC_GFX3D_RCG         0x101cu
+
+static void
+g6_gpu_clock_up(void)
+{
+	uint32_t mhz = 300, field, cfg;
+
+	PE_parse_boot_argn("sweetgpuclk", &mhz, sizeof(mhz));
+	if (mhz == 0) {
+		return;
+	}
+	field = mhz >= 600 ? 0 : mhz >= 400 ? 2 : mhz >= 300 ? 3 : 5;          /* GPLL0 600 MHz / 1, 1.5, 2, 3 */
+	g6_wr(G6_GCC_PA + G6_GCC_GPLL0_VOTE, g6_rd(G6_GCC_PA + G6_GCC_GPLL0_VOTE) | 1u);
+	g6_wr(G6_GCC_PA + G6_GCC_GPU_GPLL0_GATE, g6_rd(G6_GCC_PA + G6_GCC_GPU_GPLL0_GATE) | (1u << 15));
+	if (!g6_wait(G6_GCC_PA + 0x0, 1u << 31, true, 20)) {
+		printf("SWEET GPU615: gpu clock: GPLL0 did not lock (mode %#x): clock left alone\n", g6_rd(G6_GCC_PA + 0x0));
+		return;
+	}
+	printf("SWEET GPU615: gpu clock: GPLL0 locked (mode %#x), gfx3d rcg cfg %#x cmd %#x before\n", g6_rd(G6_GCC_PA + 0x0),
+	    g6_rd(G6_CC_PA + G6_CC_GFX3D_RCG + 4u), g6_rd(G6_CC_PA + G6_CC_GFX3D_RCG));
+	cfg = (5u << 8) | field;
+	g6_wr(G6_CC_PA + G6_CC_GFX3D_RCG + 4u, cfg);
+	g6_wr(G6_CC_PA + G6_CC_GFX3D_RCG, g6_rd(G6_CC_PA + G6_CC_GFX3D_RCG) | 1u);          /* UPDATE */
+	bool done = g6_wait(G6_CC_PA + G6_CC_GFX3D_RCG, 1u, false, 10);
+	printf("SWEET GPU615: gpu clock: %u MHz requested (cfg %#x): update %s, rcg cfg %#x cmd %#x\n", mhz, cfg, done ? "done" : "TIMEOUT",
+	    g6_rd(G6_CC_PA + G6_CC_GFX3D_RCG + 4u), g6_rd(G6_CC_PA + G6_CC_GFX3D_RCG));
+}
