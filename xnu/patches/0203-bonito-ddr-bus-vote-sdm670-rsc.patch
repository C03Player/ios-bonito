 }
 
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+extern void sweet_rpmh_set_rsc(uint32_t rsc, uint32_t tcs);
+
+/*
+ * Patch 0203: DDR (BCM "MC0") and the memory NoC ("SH0") voted to their top levels, as the Pixel 4 port does (patch 0122: ABL's level left the CPUs' bandwidth at 13.7 GB/s, 19.6 voted
+ * up). Nothing else votes them for the GPU here: a GPU copy moved 2.25 GB/s each way against about 14.9 GB/s of peak (two 16-bit LPDDR4X channels at 1866 MHz, Snapdragon 670/710).
+ * The SDM670's apps RSC DRV 2 is at 0x179e0000 (TCS 0xd00 on). A BCM command is commit | valid | x (average) | y (peak). Boot-arg sweetddr=1 turns it on (off by default for now).
+ */
+static void
+g6_bus_vote(void)
+{
+	uint32_t on = 0;                /* off until the first boot shows the RSC answers (boot-arg sweetddr=1) */
+
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	sweet_rpmh_set_rsc(0x179e0000u, 0x179e0d00u);
+	static const char *const bcm[] = { "MC0", "SH0" };
+	for (unsigned i = 0; i < sizeof(bcm) / sizeof(bcm[0]); i++) {
+		uint32_t off = 0, val = 1u << 30 | 1u << 29 | 0x3fffu << 14 | 0x3fffu;
+		int rc = sweet_rpmh_write(bcm[i], 1, &off, &val);
+		printf("SWEET GPU615: bus vote %s top -> %d\n", bcm[i], rc);
+	}
+}
