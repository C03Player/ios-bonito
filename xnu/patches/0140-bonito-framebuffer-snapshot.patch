+/*
+ * Framebuffer snapshots (boot-arg sweetshot=SECS, 1..600; default off): every SECS seconds the pixels the panel shows (what
+ * iOS has drawn) are written to one of two alternating slots just below the console log area. A slot is one header block
+ * ("SWEETSHT", u32 version 1, u32 width, u32 height, u32 rowbytes, u64 seq, u64 seq*period) followed by
+ * rowbytes*height bytes of BGRA pixels; the header is written last, so the slot with the higher seq is complete. Read from
+ * the recovery with bonito/tools/sweet-shot-pull.py: the camera-free way to see what iOS draws. The pixel copy is made
+ * 1 MiB at a time with the eMMC lock held per chunk, so root file system I/O only waits briefly.
+ */
+#define SWEET_SHOT_MAX_BYTES    (10u << 20)
+#define SWEET_SHOT_BLOCKS       (1 + SWEET_SHOT_MAX_BYTES / UFS_BLOCK)
+
+struct sweet_shot_header {
+	char magic[8];
+	uint32_t version, width, height, rowbytes;
+	uint64_t seq, secs;
+};
+
+static uint32_t sweet_shot_period;
+
+static void
+sweet_shot_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	uint64_t logbase = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	vm_offset_t fbva = 0;           /* v_baseAddr is the panel's PHYSICAL address here: map it ourselves */
+	uint64_t fbphys = 0, fbbytes = 0;
+
+	printf("SWEET SHOT: framebuffer snapshot every %u s into two slots below the log (block 0x%llx)\n",
+	    sweet_shot_period, logbase - 8 - 2 * (uint64_t)SWEET_SHOT_BLOCKS);
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetshot", hz * (int)sweet_shot_period);
+		PE_Video v;
+		if (PE_current_console(&v) != 0 || v.v_baseAddr == 0 || v.v_width == 0 || v.v_height == 0) {
+			continue;
+		}
+		uint64_t bytes = (uint64_t)v.v_rowBytes * v.v_height;
+		if (bytes == 0 || bytes > SWEET_SHOT_MAX_BYTES) {
+			continue;
+		}
+		if (fbva == 0 || fbphys != (uint64_t)v.v_baseAddr || fbbytes != bytes) {
+			extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+			fbva = ml_io_map_wcomb((vm_offset_t)v.v_baseAddr, (vm_size_t)round_page(bytes));
+			fbphys = (uint64_t)v.v_baseAddr;
+			fbbytes = bytes;
+			if (fbva == 0) {
+				printf("SWEET SHOT: cannot map the panel memory\n");
+				return;
+			}
+		}
+		uint64_t slot = logbase - 8 - (1 + (seq & 1)) * (uint64_t)SWEET_SHOT_BLOCKS;
+		int error = 0;
+		for (uint64_t off = 0; off < bytes && !error; off += BOUNCE_SIZE) {
+			uint32_t n = (uint32_t)MIN((uint64_t)BOUNCE_SIZE, bytes - off);
+			uint32_t blocks = (n + UFS_BLOCK - 1) / UFS_BLOCK;
+			lck_mtx_lock(&sweet_ufs_lock);
+			bzero((char *)bounce + (blocks * UFS_BLOCK - UFS_BLOCK), UFS_BLOCK);
+			memcpy(bounce, (const void *)(fbva + off), n);
+			error = ufs_write_blocks(slot + 1 + off / UFS_BLOCK, blocks);
+			lck_mtx_unlock(&sweet_ufs_lock);
+		}
+		if (!error) {
+			uint64_t shot = ++seq;
+			struct sweet_shot_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'S', 'H', 'T' }, .version = 1,
+				.width = (uint32_t)v.v_width, .height = (uint32_t)v.v_height, .rowbytes = (uint32_t)v.v_rowBytes,
+				.seq = shot, .secs = shot * sweet_shot_period,
+			};
+			lck_mtx_lock(&sweet_ufs_lock);
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(slot, 1);
+			lck_mtx_unlock(&sweet_ufs_lock);
+		}
+		if (error) {
+			printf("SWEET SHOT: write failed (%d), stopping\n", error);
+			return;
+		}
+	}
+}
+
+void sweet_shot_start(void);
+void
+sweet_shot_start(void)
+{
+	uint32_t secs = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetshot", &secs, sizeof(secs));
+	if (secs == 0 || secs > 600 || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS + 2 * SWEET_SHOT_BLOCKS + 16) {
+		return;
+	}
+	sweet_shot_period = secs;
+	if (kernel_thread_start(sweet_shot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
