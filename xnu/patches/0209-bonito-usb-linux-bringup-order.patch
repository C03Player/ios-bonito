+/*
+ * bonito: Qualcomm wrapper + DWC3 registers of the downstream Linux bring-up (drivers/usb/dwc3/dwc3-msm.c, core.c), used by sweetusbfix below.
+ * The SS PHY is not running on iOS, so after every controller reset the wrapper must switch the controller's pipe clock domain to the UTMI clock
+ * (POST_RESET "HS-only" sequence); without it endpoint commands that need that clock never complete (ep0 SETEPCONFIG timed out in the 2026-11-24 test).
+ */
+#define UW_GUSB2PHYCFG          0xc200
+#define UW_GUSB3PIPECTL         0xc2c0
+#define UW_GUCTL                0xc12c
+#define UW_GFLADJ               0xc630
+#define UW_GDBGLTSSM            0xc164
+#define UW_PHYSOFTRST           (1u << 31)
+#define UW_GCTL_CORESOFTRESET   (1u << 11)
+#define UW_QS_GENERAL_CFG       0x08
+#define UW_QS_CGCTL             0x28
+#define UW_PIPE_UTMI_CLK_SEL    (1u << 0)
+#define UW_PIPE3_PHYSTATUS_SW   (1u << 3)
+#define UW_PIPE_UTMI_CLK_DIS    (1u << 8)
+static vm_offset_t ud_qs;       /* QSCRATCH mapping, set before the reset */
+
+static void
+ud_dump_regs(const char *why, unsigned ep)
+{
+	printf("SWEET USB: %s: DEPCMD%u %08x par %08x %08x %08x | DSTS %08x DCTL %08x GCTL %08x GSTS %08x | GUSB2PHYCFG %08x GUSB3PIPECTL %08x LTSSM %08x\n",
+	    why, ep, dwc_rd(DEPCMD(ep)), dwc_rd(DEPCMDPAR0(ep)), dwc_rd(DEPCMDPAR1(ep)), dwc_rd(DEPCMDPAR2(ep)),
+	    dwc_rd(DSTS), dwc_rd(DCTL), dwc_rd(GCTL), dwc_rd(0xc118), dwc_rd(UW_GUSB2PHYCFG), dwc_rd(UW_GUSB3PIPECTL), dwc_rd(UW_GDBGLTSSM));
+	if (ud_qs) {
+		printf("SWEET USB: %s: QSCRATCH GENERAL_CFG %08x HS_PHY_CTRL %08x SS_PHY_CTRL %08x CGCTL %08x | GUCTL %08x GFLADJ %08x\n", why,
+		    usb_rd(ud_qs, UW_QS_GENERAL_CFG), usb_rd(ud_qs, QSCRATCH_HS_PHY_CTRL), usb_rd(ud_qs, QSCRATCH_SS_PHY_CTRL),
+		    usb_rd(ud_qs, UW_QS_CGCTL), dwc_rd(UW_GUCTL), dwc_rd(UW_GFLADJ));
+	}
+}
+
+/* dwc3-msm POST_RESET: wrapper clock gating, HS-only pipe clock switch, reference clock timing (19.2 MHz UTMI clock). */
+static void
+ud_wrapper_post_reset(void)
+{
+	if (!ud_qs) {
+		return;
+	}
+	*(volatile uint32_t *)(ud_qs + UW_QS_CGCTL) = usb_rd(ud_qs, UW_QS_CGCTL) | 0x18;
+	*(volatile uint32_t *)(ud_qs + UW_QS_GENERAL_CFG) = usb_rd(ud_qs, UW_QS_GENERAL_CFG) | UW_PIPE_UTMI_CLK_DIS;
+	delay(5);
+	*(volatile uint32_t *)(ud_qs + UW_QS_GENERAL_CFG) = usb_rd(ud_qs, UW_QS_GENERAL_CFG) | UW_PIPE_UTMI_CLK_SEL | UW_PIPE3_PHYSTATUS_SW;
+	delay(5);
+	*(volatile uint32_t *)(ud_qs + UW_QS_GENERAL_CFG) = usb_rd(ud_qs, UW_QS_GENERAL_CFG) & ~UW_PIPE_UTMI_CLK_DIS;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t guctl = (dwc_rd(UW_GUCTL) & ~(0x3ffu << 22)) | (52u << 22);
+	uint32_t gfladj = dwc_rd(UW_GFLADJ);
+	gfladj &= ~((1u << 31) | (0x7fu << 24) | (1u << 23) | (0x3fffu << 8));
+	gfladj |= (12u << 24) | (1u << 31) | (1u << 23) | (200u << 8);
+	dwc_wr(UW_GUCTL, guctl);
+	dwc_wr(UW_GFLADJ, gfladj);
+	printf("SWEET USB: wrapper post-reset done: GENERAL_CFG %08x CGCTL %08x GUCTL %08x GFLADJ %08x\n",
+	    usb_rd(ud_qs, UW_QS_GENERAL_CFG), usb_rd(ud_qs, UW_QS_CGCTL), dwc_rd(UW_GUCTL), dwc_rd(UW_GFLADJ));
+}
+
