-		delay(1000);
+	/*
+	 * sweetusbfix (default 3) selects the bring-up order, after the downstream Linux driver:
+	 *   bit 0: wrapper post-reset sequence (HS-only pipe clock switch, clock gating, reference clock timing) after the reset
+	 *   bit 1: HS PHY init and the VBUS override BEFORE the reset (Linux powers the PHY first; ABL may have powered it down)
+	 *   bit 2: reset the way downstream does: GCTL core reset + both PHY soft resets held 100 ms each (instead of DCTL CSFTRST)
+	 */
+	int fix = 3;
+	PE_parse_boot_argn("sweetusbfix", &fix, sizeof(fix));
+	printf("SWEET USB: sweetusbfix %d\n", fix);
+	ud_qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (fix & 2) {
+		ud_hsphy_init();
+		if (ud_qs) {
+			*(volatile uint32_t *)(ud_qs + QSCRATCH_HS_PHY_CTRL) = usb_rd(ud_qs, QSCRATCH_HS_PHY_CTRL) | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+			*(volatile uint32_t *)(ud_qs + QSCRATCH_SS_PHY_CTRL) = usb_rd(ud_qs, QSCRATCH_SS_PHY_CTRL) | LANE0_PWR_PRESENT;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("SWEET USB: PHY first: VBUS override on: HS_PHY_CTRL %08x SS_PHY_CTRL %08x\n",
+			    usb_rd(ud_qs, QSCRATCH_HS_PHY_CTRL), usb_rd(ud_qs, QSCRATCH_SS_PHY_CTRL));
+		}
 	}
-	printf("SWEET USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
-	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
-	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
-		return;
+	int i = 0;
+	if (fix & 4) {
+		dwc_wr(GCTL, dwc_rd(GCTL) | UW_GCTL_CORESOFTRESET);
+		dwc_wr(UW_GUSB3PIPECTL, dwc_rd(UW_GUSB3PIPECTL) | UW_PHYSOFTRST);
+		dwc_wr(UW_GUSB2PHYCFG, dwc_rd(UW_GUSB2PHYCFG) | UW_PHYSOFTRST);
+		if (!(fix & 2)) {
+			ud_hsphy_init();
+		}
+		delay(100000);
+		dwc_wr(UW_GUSB3PIPECTL, dwc_rd(UW_GUSB3PIPECTL) & ~UW_PHYSOFTRST);
+		dwc_wr(UW_GUSB2PHYCFG, dwc_rd(UW_GUSB2PHYCFG) & ~UW_PHYSOFTRST);
+		delay(100000);
+		dwc_wr(GCTL, dwc_rd(GCTL) & ~UW_GCTL_CORESOFTRESET);
+		printf("SWEET USB: downstream-style core reset done, GCTL 0x%08x DCFG 0x%08x\n", dwc_rd(GCTL), dwc_rd(DCFG));
+	} else {
+		/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+		dwc_wr(DCTL, DCTL_CSFTRST);
+		for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+			delay(1000);
+		}
+		printf("SWEET USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+		    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+		if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+			return;
+		}
+	}
+	if (fix & 1) {
+		ud_wrapper_post_reset();
 	}
 
 	printf("SWEET USB: step event buffer at 0x%llx\n", ud.dma_pa + UD_EVT);
@@ -1357,9 +1452,11 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	printf("SWEET USB: step start setup\n");
 	ud_start_setup();
 	printf("SWEET USB: step qscratch\n");
-	ud_hsphy_init();
