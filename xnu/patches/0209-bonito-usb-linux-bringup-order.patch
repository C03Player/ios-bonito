 		uint32_t v = dwc_rd(DEPCMD(ep));
 		if (!(v & DEPCMD_CMDACT)) {
 			uint32_t status = (v >> 12) & 0xf;
@@ -299,9 +355,10 @@ ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
 			}
 			return 0;
 		}
-		delay(1);
+		delay(5);
 	}
 	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	ud_dump_regs("ep cmd timeout", ep);
 	return -1;
 }
 
@@ -1317,16 +1374,54 @@ sweet_usb_gadget_start(vm_offset_t dwc)
