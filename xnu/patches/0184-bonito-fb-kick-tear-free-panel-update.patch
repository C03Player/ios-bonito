+
+/*
+ * Patch 0184: tear-free panel updates (boot-arg sweetfb_kick=1, default off). The panel is a command-mode DSI panel (SOFEF00 or NT37700F) that the display engine
+ * (SDE 4.0.1, MDP at 0xae00000) refreshes from the splash framebuffer on every TE pulse ("autorefresh", armed by the shim and by ABL, PINGPONG + 0x30). The CPU copy
+ * of a frame overlaps those transfers: the panel shows bands of the old and the new frame (the user's "it misses chunks and uses the old frame"; a copy takes 6.5 ms, a
+ * transfer about as long). With kick mode the autorefresh is switched off and CTL_START starts exactly one transfer after each finished copy (it waits for the next TE
+ * pulse); the next copy begins at least two vsync ticks later, when that transfer is over. Offsets as in bonito/shim/sde.c: CTL(n) = MDP + 0x2000 + 0x200 n, CTL_LAYER(lm)
+ * 0x04 lm, CTL_START 0x01c; PP(n) = MDP + 0x71000 + 0x800 n, TEAR_CHECK_EN 0x000, AUTOREFRESH_CONFIG 0x030.
+ */
+static volatile uint8_t *sweet_fb_pp, *sweet_fb_ctl;
+static bool sweet_fb_kick;
+static uint64_t sweet_fb_last_copy;
+
+static inline uint32_t
+sweet_fb_rd(volatile uint8_t *base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+sweet_fb_wr(volatile uint8_t *base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+sweet_fb_kick_init(void)
+{
+	volatile uint8_t *pp = (volatile uint8_t *)ml_io_map(0xae71000, 0x1000);
+	volatile uint8_t *ctl = (volatile uint8_t *)ml_io_map(0xae02000, 0x1000);
+
+	if (pp == NULL || ctl == NULL) {
+		IOLog("SWEET FB: kick: cannot map the SDE registers\n");
+		return;
+	}
+	int ppn = -1, ctln = -1;
+	for (int i = 0; i < 2; i++) {
+		IOLog("SWEET FB: kick: pp%d tear_en %#x intcnt %#x line %#x autoref %#x\n", i, sweet_fb_rd(pp, 0x800 * i), sweet_fb_rd(pp, 0x800 * i + 0x14),
+		    sweet_fb_rd(pp, 0x800 * i + 0x2c), sweet_fb_rd(pp, 0x800 * i + 0x30));
+		if (ppn < 0 && (sweet_fb_rd(pp, 0x800 * i) & 1)) {
+			ppn = i;
+		}
+	}
+	for (int i = 0; i < 5; i++) {
+		IOLog("SWEET FB: kick: ctl%d l0 %#x l1 %#x top %#x flush %#x\n", i, sweet_fb_rd(ctl, 0x200 * i), sweet_fb_rd(ctl, 0x200 * i + 4),
+		    sweet_fb_rd(ctl, 0x200 * i + 0x14), sweet_fb_rd(ctl, 0x200 * i + 0x18));
+		if (ctln < 0 && (sweet_fb_rd(ctl, 0x200 * i) | sweet_fb_rd(ctl, 0x200 * i + 4))) {
+			ctln = i;
+		}
+	}
+	if (ppn < 0 || ctln < 0) {
+		IOLog("SWEET FB: kick: no active pingpong (%d) or ctl (%d): autorefresh stays on\n", ppn, ctln);
+		return;
+	}
+	sweet_fb_pp = pp + 0x800 * ppn;
+	sweet_fb_ctl = ctl + 0x200 * ctln;
+	sweet_fb_wr(sweet_fb_pp, 0x30, 0);              /* autorefresh off */
+	IOLog("SWEET FB: kick: pp%d ctl%d, autorefresh now %#x\n", ppn, ctln, sweet_fb_rd(sweet_fb_pp, 0x30));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sweet_fb_wr(sweet_fb_ctl, 0x1c, 1);             /* one transfer of what the panel memory holds now */
+	sweet_fb_kick = true;
+}
+
+static inline void
+sweet_fb_kick_now(void)
+{
+	if (sweet_fb_kick) {
+		__asm__ volatile ("dsb sy" ::: "memory");      /* the copy's stores are in memory before the transfer starts */
+		sweet_fb_wr(sweet_fb_ctl, 0x1c, 1);
+	}
 }
 
