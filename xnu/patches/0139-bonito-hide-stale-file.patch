 }
+/*
+ * Boot-arg sweethide=WORD[,WORD...] (words >= 6 characters): open() of a path containing a word fails with ENOENT
+ * until some process opens such a path for writing or creating it (then the file counts as refreshed and nothing is
+ * hidden any more). For a stale cache that is trusted across boots and has to be recomputed, e.g. MobileGestalt's
+ * com.apple.MobileGestalt.plist, written while the device tree still lacked /product (ArtworkTraits without
+ * ArtworkDeviceIdiom: CoreUI then looks up idiom 0 and finds none of the phone-only assets).
+ */
+static bool
+sweet_hide_open(struct nameidata *ndp, int uflags)
+{
+	static char list[200];
+	static int state;       /* 0 not parsed, 1 off, 2 on, 3 refreshed */
+	static int shown;
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweethide", list, sizeof(list)) && list[0] ? 2 : 1;
+	}
+	if (state != 2 || !UIO_SEG_IS_USER_SPACE(ndp->ni_segflg)) {
+		return false;
+	}
+	char path[256];
+	size_t len = 0;
+	if (copyinstr(ndp->ni_dirp, path, sizeof(path), &len) != 0) {
+		return false;
+	}
+	for (const char *w = list; *w;) {
+		size_t n = 0;
+		while (w[n] && w[n] != ',') {
+			n++;
+		}
+		char word[64];
+		if (n >= 6 && n < sizeof(word)) {
+			memcpy(word, w, n);
+			word[n] = '\0';
+			if (strnstr(path, word, len) != NULL) {
+				if (uflags & (O_CREAT | O_WRONLY | O_RDWR | O_TRUNC)) {
+					state = 3;
+					printf("SWEET HIDE: %s opened for writing, no longer hidden\n", path);
+					return false;
+				}
+				if (shown++ < 6) {
+					printf("SWEET HIDE: %s hidden (ENOENT)\n", path);
+				}
+				return true;
+			}
+		}
+		w += n + (w[n] == ',');
+	}
+	return false;
+}
 #endif
 
