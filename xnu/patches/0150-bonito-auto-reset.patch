diff --git a/bsd/dev/bonito_reset.c b/bsd/dev/bonito_reset.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/bonito_reset.c
@@ -0,0 +1,190 @@
+/*
+ * Unattended restarts for the test loop (so nobody has to hold Power):
+ *
+ *   sweetreboot=SECS      reset the chip SECS seconds after start (after letting the persistent log flush)
+ *   sweetpanicreset=1     reset right after a panic's log has been written (hook in osfmk/kern/debug.c)
+ *   sweetwdt=SECS         arm the SoC watchdog (SECS <= 30) and pet it from a kernel thread; a hung kernel gets reset
+ *   sweetresetmethod=N    0 PS_HOLD (what Android's msm restart does), 1 PSCI SYSTEM_RESET, 2 PS_HOLD then PSCI (default 0)
+ *   test hooks: sweetpanictest=SECS panics on purpose, sweetwdttest=SECS stops petting the watchdog
+ *
+ * After the reset the boot ROM/ABL starts boot_a like after a long Power press (the log-reading recovery), which
+ * bonito/tools/cycle.sh then uses. Registers: PS_HOLD 0xc264000 (DT qcom,pshold), APSS watchdog 0x17980000 (qcom,msm-watchdog:
+ * WDT0_RST 0x04, EN 0x08, STS 0x0c, BARK 0x10, BITE 0x14; 32.768 kHz ticks, 20-bit counters, so at most 32 s). Both pages are
+ * mapped when the feature starts, since a panic cannot map memory.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/debug.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_smc(uint64_t x[8]);
+extern int hz;
+void sweet_reset_start(void);
+void sweet_reset_now(const char *why);
+void sweet_reset_after_panic(void);
+
+#define RS_PSHOLD_PA    0x0c264000u
+#define RS_WDT_PA       0x17980000u
+#define RS_WDT_RST      0x04u
+#define RS_WDT_EN       0x08u
+#define RS_WDT_STS      0x0cu
+#define RS_WDT_BARK     0x10u
+#define RS_WDT_BITE     0x14u
+#define RS_WDT_HZ       32768u
+
+static vm_offset_t rs_pshold, rs_wdt;
+static int rs_chan, rs_panic_reset, rs_method;
+static volatile bool rs_wdt_petting;
+
+static void
+rs_pshold_reset(void)
+{
+	if (rs_pshold) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		*(volatile uint32_t *)rs_pshold = 0;    /* deassert PS_HOLD: the PMIC resets the chip */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(2000000);
+	}
+}
+
+static void
+rs_psci_reset(void)
+{
+	uint64_t x[8] = { 0x84000009ull, 0, 0, 0, 0, 0, 0, 0 };      /* PSCI SYSTEM_RESET */
+	sweet_smc(x);
+	delay(2000000);
+}
+
+void
+sweet_reset_now(const char *why)
+{
+	printf("SWEET RESET: %s (method %d)\n", why, rs_method);
+	delay(300000);
+	if (rs_method == 1) {
+		rs_psci_reset();
+		rs_pshold_reset();
+	} else {
+		rs_pshold_reset();
+		if (rs_method == 2) {
+			rs_psci_reset();
+		}
+	}
+	printf("SWEET RESET: still running after the reset attempts\n");
+}
+
+/* Called by the panic path once the panic text is on the eMMC. */
+void
+sweet_reset_after_panic(void)
+{
+	if (rs_panic_reset) {
+		sweet_reset_now("panic");
+	}
+}
+
+static void
+rs_wait(unsigned secs)
+{
+	(void)tsleep(&rs_chan, PZERO, "sweetreset", (int)(hz * secs));
+}
+
+static void
+rs_timed_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int secs = 0;
+	PE_parse_boot_argn("sweetreboot", &secs, sizeof(secs));
+	printf("SWEET RESET: timed reset in %d s\n", secs);
+	rs_wait((unsigned)secs);
+	printf("SWEET RESET: time is up; waiting for the log to flush\n");
+	rs_wait(4);
+	sweet_reset_now("timed");
+	for (;;) {
+		rs_wait(60);
+	}
+}
+
+static void
+rs_panic_test_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int secs = 0;
+	PE_parse_boot_argn("sweetpanictest", &secs, sizeof(secs));
+	rs_wait((unsigned)secs);
+	panic("SWEET test panic (sweetpanictest)");
+}
+
+static void
+rs_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int secs = 20, test = 0;
+	unsigned waited = 0;
+
+	PE_parse_boot_argn("sweetwdt", &secs, sizeof(secs));
+	PE_parse_boot_argn("sweetwdttest", &test, sizeof(test));
+	if (secs < 4) {
+		secs = 4;
+	}
+	if (secs > 30) {
+		secs = 30;
+	}
+	printf("SWEET RESET: watchdog before: en %#x sts %#x bark %#x bite %#x\n", *(volatile uint32_t *)(rs_wdt + RS_WDT_EN),
+	    *(volatile uint32_t *)(rs_wdt + RS_WDT_STS), *(volatile uint32_t *)(rs_wdt + RS_WDT_BARK),
+	    *(volatile uint32_t *)(rs_wdt + RS_WDT_BITE));
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_EN) = 0;
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_BARK) = 0xfffffu;        /* never before the bite */
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_BITE) = (uint32_t)secs * RS_WDT_HZ;
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_RST) = 1;
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_EN) = 1;
+	*(volatile uint32_t *)(rs_wdt + RS_WDT_RST) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET RESET: watchdog armed, bite after %d s, petted every %d s%s\n", secs, secs / 3,
+	    test ? " (test: stops petting later)" : "");
+	rs_wdt_petting = true;
+	for (;;) {
+		if (test && waited >= (unsigned)test) {
+			printf("SWEET RESET: watchdog test: no more petting; expect a reset within %d s\n", secs);
+			for (;;) {
+				rs_wait(3600);
+			}
+		}
+		*(volatile uint32_t *)(rs_wdt + RS_WDT_RST) = 1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		rs_wait((unsigned)(secs / 3));
+		waited += (unsigned)(secs / 3);
+	}
+}
+
+void
+sweet_reset_start(void)
+{
+	int reboot = 0, wdt = 0, ptest = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetreboot", &reboot, sizeof(reboot));
+	PE_parse_boot_argn("sweetpanicreset", &rs_panic_reset, sizeof(rs_panic_reset));
+	PE_parse_boot_argn("sweetwdt", &wdt, sizeof(wdt));
+	PE_parse_boot_argn("sweetpanictest", &ptest, sizeof(ptest));
+	PE_parse_boot_argn("sweetresetmethod", &rs_method, sizeof(rs_method));
+	if (!reboot && !rs_panic_reset && !wdt && !ptest) {
+		return;
+	}
+	rs_pshold = ml_io_map(RS_PSHOLD_PA, 0x1000) + (RS_PSHOLD_PA & 0xfffu);
+	printf("SWEET RESET: pshold %s; timed reset %d s, reset after panic %d, watchdog %d s, method %d\n",
+	    rs_pshold ? "mapped" : "NOT mapped", reboot, rs_panic_reset, wdt, rs_method);
+	if (reboot && kernel_thread_start(rs_timed_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (ptest && kernel_thread_start(rs_panic_test_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (wdt) {
+		rs_wdt = ml_io_map(RS_WDT_PA, 0x1000);
+		if (rs_wdt && kernel_thread_start(rs_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
