+/*
+ * Keep-awake taps (boot-arg sweetwake=SECS, 1..600; default off): until real touch input is ported iOS's idle timer
+ * puts the screen to sleep ~10-30 s after it wakes and nothing can wake it again. Every SECS seconds a short tap is
+ * injected into the HID touch service in the middle of the panel (nothing to hit on the lock screen; NOT near an edge:
+ * contacts within 48 px of an edge are flagged edge-tip and do not count as normal activity): that resets the idle
+ * timer, and iOS's tap-to-wake wakes a sleeping screen. Coordinates are panel pixels.
+ */
+static uint32_t sweet_wake_period;
+
+static void
+sweet_wake_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	extern void sweet_hid_touch(int finger, int down, int x, int y);
+	static int chan;
+
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetwake", hz * (int)sweet_wake_period);
+		sweet_hid_touch(0, 1, 540, 1000);
+		(void)tsleep(&chan, PZERO, "sweetwake", hz / 10);
+		sweet_hid_touch(0, 0, 540, 1000);
+	}
+}
+
+void sweet_wake_start(void);
+void
+sweet_wake_start(void)
+{
+	uint32_t secs = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetwake", &secs, sizeof(secs));
+	if (secs == 0 || secs > 600) {
+		return;
+	}
+	sweet_wake_period = secs;
+	if (kernel_thread_start(sweet_wake_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
