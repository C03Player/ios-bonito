@@ -1387,6 +1438,10 @@ handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr
 			vm_fault_addr = tbi_clear(fault_addr);
 		}
 
+		if (is_translation_fault(fault_code)) {
+			sweet_livelock_check(state, vm_fault_addr);
+		}
+
