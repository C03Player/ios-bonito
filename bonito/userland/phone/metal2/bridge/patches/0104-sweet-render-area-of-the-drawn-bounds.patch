diff --git a/crates/metal2vulkan-runtime/src/render.rs b/crates/metal2vulkan-runtime/src/render.rs
index 086b582..e63d817 100644
--- a/crates/metal2vulkan-runtime/src/render.rs
+++ b/crates/metal2vulkan-runtime/src/render.rs
@@ -3859,10 +3859,52 @@ impl RenderCommandEncoder {
             }
         }
         let [width, height] = layout.extent;
-        let render_area = vk::Rect2D {
+        let mut render_area = vk::Rect2D {
             offset: vk::Offset2D { x: 0, y: 0 },
             extent: vk::Extent2D { width, height },
         };
+        // Sweet (bonito): a plain pass that loads every color and clears nothing renders only inside the bounds of what its draws can write (their scissors within their viewports,
+        // `DrawnArea`), the tiles rounded out to 32 pixels: the GPU loads and stores only the tiles of the render area instead of the whole surface. The render server draws damage
+        // rectangles into the full-screen surface (3292 passes of 1080x2160 loading and storing the whole surface in one 4 minute run: 96 % of all the pixels). Any other kind of pass
+        // (several instances, tile dispatches, shadowed or rotated textures, reformats, resolves, a depth or stencil attachment, a clear) keeps the whole area.
+        // SWEET_FULL_AREA in the environment turns this off.
+        let plain = instances.len() == 1
+            && dispatches.is_empty()
+            && !texels_shadowed
+            && !resolve_after
+            && resolved.is_empty()
+            && later_resolves.is_empty()
+            && rewritten.is_none()
+            && copy_in.is_none()
+            && stand_ins_in.is_none()
+            && reach_clears.is_none()
+            && layout.depth_stencil.is_none()
+            && instances.iter().all(|instance| instance.reformats.is_empty())
+            && layout
+                .colors
+                .iter()
+                .flatten()
+                .all(|color| color.load != LoadAction::Clear)
+            && std::env::var_os("SWEET_FULL_AREA").is_none();
+        if plain {
+            if let Some([x0, y0, x1, y1]) = drawn.bounds() {
+                let (x0, y0) = (x0 / 32 * 32, y0 / 32 * 32);
+                let (x1, y1) = (x1.div_ceil(32) * 32, y1.div_ceil(32) * 32);
+                let (x1, y1) = (x1.min(width), y1.min(height));
+                if x0 < x1 && y0 < y1 && (x1 - x0) * (y1 - y0) < width * height {
+                    render_area = vk::Rect2D {
+                        offset: vk::Offset2D {
+                            x: x0 as i32,
+                            y: y0 as i32,
+                        },
+                        extent: vk::Extent2D {
+                            width: x1 - x0,
+                            height: y1 - y0,
+                        },
+                    };
+                }
+            }
+        }
         if let Some(first) = &first_texel_copies {
             core.shadow_copies(first);
         }
